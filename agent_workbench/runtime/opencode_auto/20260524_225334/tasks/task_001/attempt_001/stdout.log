{"type":"tool_use","timestamp":1779634454581,"sessionID":"ses_1a585a990ffeYIaNqs5NDPs5Jn","part":{"type":"tool","tool":"read","callID":"019e5a7abe1751f9c9738e9693ed92cf","state":{"status":"completed","input":{"filePath":"H:\\stm32_RAG\\code\\serial\\Core\\Src\\app_cli_commands.c"},"output":"<path>H:\\stm32_RAG\\code\\serial\\Core\\Src\\app_cli_commands.c</path>\n<type>file</type>\n<content>\n1: #include \"app_cli_commands.h\"\n2: \n3: #include <string.h>\n4: \n5: #define APP_LED_ON GPIO_PIN_SET\n6: #define APP_LED_OFF GPIO_PIN_RESET\n7: \n8: typedef enum\n9: {\n10:   APP_LED_TARGET_INVALID = 0,\n11:   APP_LED_TARGET_RED,\n12:   APP_LED_TARGET_GREEN,\n13:   APP_LED_TARGET_BLUE,\n14:   APP_LED_TARGET_ALL\n15: } AppLedTarget;\n16: \n17: typedef enum\n18: {\n19:   APP_LED_ACTION_INVALID = 0,\n20:   APP_LED_ACTION_ON,\n21:   APP_LED_ACTION_OFF,\n22:   APP_LED_ACTION_TOGGLE\n23: } AppLedAction;\n24: \n25: static void AppCli_Help(CliContext *cli, int argc, char **argv);\n26: static void AppCli_Status(CliContext *cli, int argc, char **argv);\n27: static void AppCli_Led(CliContext *cli, int argc, char **argv);\n28: static void AppCli_Red(CliContext *cli, int argc, char **argv);\n29: static void AppCli_Green(CliContext *cli, int argc, char **argv);\n30: static void AppCli_Blue(CliContext *cli, int argc, char **argv);\n31: static void AppCli_All(CliContext *cli, int argc, char **argv);\n32: static void AppCli_LedStatus(CliContext *cli, int argc, char **argv);  // NEW: led_status handler\n33: \n34: static void AppCli_PrintCommandHelp(CliContext *cli, const CliCommand *command);\n35: static void AppCli_PrintLedStatus(CliContext *cli, const char *name, GPIO_TypeDef *port, uint16_t pin);\n36: static AppLedTarget AppCli_ParseTarget(const char *text);\n37: static AppLedAction AppCli_ParseAction(const char *text);\n38: static void AppCli_HandleLedCommand(CliContext *cli, const char *target_text, const char *action_text);\n39: static void AppCli_WriteTargetState(AppLedTarget target, AppLedAction action);\n40: static void AppCli_WriteOneLed(GPIO_TypeDef *port, uint16_t pin, AppLedAction action);\n41: static const char *AppCli_GetLedStateText(GPIO_TypeDef *port, uint16_t pin);\n42: \n43: static const CliCommand app_cli_commands[] =\n44: {\n45:   { \"help\", \"List commands or show help for one command.\", \"help [command]\", AppCli_Help },\n46:   { \"status\", \"Show UART and LED status.\", \"status\", AppCli_Status },\n47:   { \"led\", \"Control one LED or all LEDs.\", \"led <red|green|blue|all> <on|off|toggle>\", AppCli_Led },\n48:   { \"red\", \"Shortcut for 'led red ...'.\", \"red <on|off|toggle>\", AppCli_Red },\n49:   { \"green\", \"Shortcut for 'led green ...'.\", \"green <on|off|toggle>\", AppCli_Green },\n50:   { \"blue\", \"Shortcut for 'led blue ...'.\", \"blue <on|off|toggle>\", AppCli_Blue },\n51:   { \"all\", \"Shortcut for 'led all ...'.\", \"all <on|off|toggle>\", AppCli_All },\n52:   { \"led_status\", \"Print the on/off state of all LEDs.\", \"led_status\", AppCli_LedStatus }\n53: };\n54: \n55: const CliCommand *AppCli_GetCommands(size_t *count)\n56: {\n57:   if (count != NULL)\n58:   {\n59:     *count = sizeof(app_cli_commands) / sizeof(app_cli_commands[0]);\n60:   }\n61: \n62:   return app_cli_commands;\n63: }\n64: \n65: static void AppCli_Help(CliContext *cli, int argc, char **argv)\n66: {\n67:   size_t index = 0U;\n68:   const CliCommand *command = NULL;\n69: \n70:   if (argc > 2)\n71:   {\n72:     Cli_RecordCommandError(NULL);\n73:     Cli_WriteString(cli, \"Usage: help [command]\\r\\n\");\n74:     return;\n75:   }\n76: \n77:   if (argc == 1)\n78:   {\n79:     Cli_WriteString(cli, \"Available commands:\\r\\n\");\n80:     for (index = 0U; index < Cli_GetCommandCount(cli); ++index)\n81:     {\n82:       command = Cli_GetCommandAt(cli, index);\n83:       Cli_Printf(cli, \"  %-8s %s\\r\\n\", command->name, command->summary);\n84:     }\n85:     Cli_WriteString(cli, \"Use 'help <command>' for details.\\r\\n\");\n86:     return;\n87:   }\n88: \n89:   command = Cli_FindCommand(cli, argv[1]);\n90:   if (command == NULL)\n91:   {\n92:     Cli_RecordCommandError(NULL);\n93:     Cli_Printf(cli, \"[error] no such command: %s\\r\\n\", argv[1]);\n94:     return;\n95:   }\n96: \n97:   AppCli_PrintCommandHelp(cli, command);\n98: }\n99: \n100: static void AppCli_Status(CliContext *cli, int argc, char **argv)\n101: {\n102:   (void)argc;\n103:   (void)argv;\n104: \n105:   Cli_WriteString(cli, \"System status:\\r\\n\");\n106:   Cli_WriteString(cli, \"  UART: USART2 @ 115200 8N1\\r\\n\");\n107:   Cli_WriteString(cli, \"  Pins: TX=PA2, RX=PA3\\r\\n\");\n108:   AppCli_PrintLedStatus(cli, \"RED\", LED_RED_GPIO_Port, LED_RED_Pin);\n109:   AppCli_PrintLedStatus(cli, \"GREEN\", LED_GREEN_GPIO_Port, LED_GREEN_Pin);\n110:   AppCli_PrintLedStatus(cli, \"BLUE\", LED_BLUE_GPIO_Port, LED_BLUE_Pin);\n111: }\n112: \n113: static void AppCli_Led(CliContext *cli, int argc, char **argv)\n114: {\n115:   if (argc != 3)\n116:   {\n117:     Cli_RecordCommandError(NULL);\n118:     Cli_WriteString(cli, \"Usage: led <red|green|blue|all> <on|off|toggle>\\r\\n\");\n119:     return;\n120:   }\n121: \n122:   AppCli_HandleLedCommand(cli, argv[1], argv[2]);\n123: }\n124: \n125: static void AppCli_Red(CliContext *cli, int argc, char **argv)\n126: {\n127:   if (argc != 2)\n128:   {\n129:     Cli_RecordCommandError(NULL);\n130:     Cli_WriteString(cli, \"Usage: red <on|off|toggle>\\r\\n\");\n131:     return;\n132:   }\n133: \n134:   AppCli_HandleLedCommand(cli, \"red\", argv[1]);\n135: }\n136: \n137: static void AppCli_Green(CliContext *cli, int argc, char **argv)\n138: {\n139:   if (argc != 2)\n140:   {\n141:     Cli_RecordCommandError(NULL);\n142:     Cli_WriteString(cli, \"Usage: green <on|off|toggle>\\r\\n\");\n143:     return;\n144:   }\n145: \n146:   AppCli_HandleLedCommand(cli, \"green\", argv[1]);\n147: }\n148: \n149: static void AppCli_Blue(CliContext *cli, int argc, char **argv)\n150: {\n151:   if (argc != 2)\n152:   {\n153:     Cli_RecordCommandError(NULL);\n154:     Cli_WriteString(cli, \"Usage: blue <on|off|toggle>\\r\\n\");\n155:     return;\n156:   }\n157: \n158:   AppCli_HandleLedCommand(cli, \"blue\", argv[1]);\n159: }\n160: \n161: static void AppCli_All(CliContext *cli, int argc, char **argv)\n162: {\n163:   if (argc != 2)\n164:   {\n165:     Cli_RecordCommandError(NULL);\n166:     Cli_WriteString(cli, \"Usage: all <on|off|toggle>\\r\\n\");\n167:     return;\n168:   }\n169: \n170:   AppCli_HandleLedCommand(cli, \"all\", argv[1]);\n171: }\n172: \n173: static void AppCli_LedStatus(CliContext *cli, int argc, char **argv)\n174: {\n175:   (void)argc;\n176:   (void)argv;\n177: \n178:   Cli_WriteString(cli, \"LED status:\\r\\n\");\n179:   AppCli_PrintLedStatus(cli, \"RED\", LED_RED_GPIO_Port, LED_RED_Pin);\n180:   AppCli_PrintLedStatus(cli, \"GREEN\", LED_GREEN_GPIO_Port, LED_GREEN_Pin);\n181:   AppCli_PrintLedStatus(cli, \"BLUE\", LED_BLUE_GPIO_Port, LED_BLUE_Pin);\n182: }\n183: \n184: static void AppCli_PrintCommandHelp(CliContext *cli, const CliCommand *command)\n185: {\n186:   Cli_Printf(cli, \"%s\\r\\n\", command->name);\n187:   Cli_Printf(cli, \"  %s\\r\\n\", command->summary);\n188:   Cli_Printf(cli, \"  Usage: %s\\r\\n\", command->usage);\n189: }\n190: \n191: static void AppCli_PrintLedStatus(CliContext *cli, const char *name, GPIO_TypeDef *port, uint16_t pin)\n192: {\n193:   Cli_Printf(cli, \"  LED %-5s: %s\\r\\n\", name, AppCli_GetLedStateText(port, pin));\n194: }\n195: \n196: static AppLedTarget AppCli_ParseTarget(const char *text)\n197: {\n198:   if (strcmp(text, \"red\") == 0)\n199:   {\n200:     return APP_LED_TARGET_RED;\n201:   }\n202: \n203:   if (strcmp(text, \"green\") == 0)\n204:   {\n205:     return APP_LED_TARGET_GREEN;\n206:   }\n207: \n208:   if (strcmp(text, \"blue\") == 0)\n209:   {\n210:     return APP_LED_TARGET_BLUE;\n211:   }\n212: \n213:   if (strcmp(text, \"all\") == 0)\n214:   {\n215:     return APP_LED_TARGET_ALL;\n216:   }\n217: \n218:   return APP_LED_TARGET_INVALID;\n219: }\n220: \n221: static AppLedAction AppCli_ParseAction(const char *text)\n222: {\n223:   if (strcmp(text, \"on\") == 0)\n224:   {\n225:     return APP_LED_ACTION_ON;\n226:   }\n227: \n228:   if (strcmp(text, \"off\") == 0)\n229:   {\n230:     return APP_LED_ACTION_OFF;\n231:   }\n232: \n233:   if (strcmp(text, \"toggle\") == 0)\n234:   {\n235:     return APP_LED_ACTION_TOGGLE;\n236:   }\n237: \n238:   return APP_LED_ACTION_INVALID;\n239: }\n240: \n241: static void AppCli_HandleLedCommand(CliContext *cli, const char *target_text, const char *action_text)\n242: {\n243:   AppLedTarget target = AppCli_ParseTarget(target_text);\n244:   AppLedAction action = AppCli_ParseAction(action_text);\n245: \n246:   if (target == APP_LED_TARGET_INVALID)\n247:   {\n248:     Cli_RecordCommandError(NULL);\n249:     Cli_Printf(cli, \"[error] invalid LED target: %s\\r\\n\", target_text);\n250:     return;\n251:   }\n252: \n253:   if (action == APP_LED_ACTION_INVALID)\n254:   {\n255:     Cli_RecordCommandError(NULL);\n256:     Cli_Printf(cli, \"[error] invalid LED action: %s\\r\\n\", action_text);\n257:     return;\n258:   }\n259: \n260:   AppCli_WriteTargetState(target, action);\n261:   Cli_Printf(cli, \"[ok] %s -> %s\\r\\n\", target_text, action_text);\n262:   AppCli_Status(cli, 0, NULL);\n263: }\n264: \n265: static void AppCli_WriteTargetState(AppLedTarget target, AppLedAction action)\n266: {\n267:   switch (target)\n268:   {\n269:     case APP_LED_TARGET_RED:\n270:       AppCli_WriteOneLed(LED_RED_GPIO_Port, LED_RED_Pin, action);\n271:       break;\n272: \n273:     case APP_LED_TARGET_GREEN:\n274:       AppCli_WriteOneLed(LED_GREEN_GPIO_Port, LED_GREEN_Pin, action);\n275:       break;\n276: \n277:     case APP_LED_TARGET_BLUE:\n278:       AppCli_WriteOneLed(LED_BLUE_GPIO_Port, LED_BLUE_Pin, action);\n279:       break;\n280: \n281:     case APP_LED_TARGET_ALL:\n282:       AppCli_WriteOneLed(LED_RED_GPIO_Port, LED_RED_Pin, action);\n283:       AppCli_WriteOneLed(LED_GREEN_GPIO_Port, LED_GREEN_Pin, action);\n284:       AppCli_WriteOneLed(LED_BLUE_GPIO_Port, LED_BLUE_Pin, action);\n285:       break;\n286: \n287:     default:\n288:       break;\n289:   }\n290: }\n291: \n292: static void AppCli_WriteOneLed(GPIO_TypeDef *port, uint16_t pin, AppLedAction action)\n293: {\n294:   GPIO_PinState next_state = APP_LED_OFF;\n295: \n296:   if (action == APP_LED_ACTION_TOGGLE)\n297:   {\n298:     HAL_GPIO_TogglePin(port, pin);\n299:     return;\n300:   }\n301: \n302:   next_state = (action == APP_LED_ACTION_ON) ? APP_LED_ON : APP_LED_OFF;\n303:   HAL_GPIO_WritePin(port, pin, next_state);\n304: }\n305: \n306: static const char *AppCli_GetLedStateText(GPIO_TypeDef *port, uint16_t pin)\n307: {\n308:   return (HAL_GPIO_ReadPin(port, pin) == APP_LED_ON) ? \"on\" : \"off\";\n309: }\n\n(End of file - total 309 lines)\n</content>","metadata":{"preview":"#include \"app_cli_commands.h\"\n\n#include <string.h>\n\n#define APP_LED_ON GPIO_PIN_SET\n#define APP_LED_OFF GPIO_PIN_RESET\n\ntypedef enum\n{\n  APP_LED_TARGET_INVALID = 0,\n  APP_LED_TARGET_RED,\n  APP_LED_TARGET_GREEN,\n  APP_LED_TARGET_BLUE,\n  APP_LED_TARGET_ALL\n} AppLedTarget;\n\ntypedef enum\n{\n  APP_LED_ACTION_INVALID = 0,\n  APP_LED_ACTION_ON,","truncated":false,"loaded":[]},"title":"Core\\Src\\app_cli_commands.c","time":{"start":1779634454559,"end":1779634454579}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"doctor 检查通过，项目状态正常。现在我需要：\n1. 查看现有的 CLI 指令实现\n2. 查看硬件配置（LED GPIO）\n3. 查看主循环实现\n\n让我读取这些文件。","format":"unknown","index":0}]}},"id":"prt_e5a7abefc001dzqivcfLlk1akF","sessionID":"ses_1a585a990ffeYIaNqs5NDPs5Jn","messageID":"msg_e5a7a80af001Z8HFLOT2EOqwNP"}}
{"type":"tool_use","timestamp":1779634454915,"sessionID":"ses_1a585a990ffeYIaNqs5NDPs5Jn","part":{"type":"tool","tool":"read","callID":"019e5a7abf6cc22c906d9ebe96e0af11","state":{"status":"completed","input":{"filePath":"H:\\stm32_RAG\\code\\serial\\Core\\Src\\cli.c"},"output":"<path>H:\\stm32_RAG\\code\\serial\\Core\\Src\\cli.c</path>\n<type>file</type>\n<content>\n1: #include \"cli.h\"\n2: \n3: #include <ctype.h>\n4: #include <stdarg.h>\n5: #include <stdio.h>\n6: #include <string.h>\n7: \n8: #define CLI_PROMPT \"cli> \"\n9: \n10: static HAL_StatusTypeDef Cli_ArmReceive(CliContext *cli);\n11: static void Cli_ResetInputState(CliContext *cli);\n12: static void CliStats_CopyLastCommand(const char *line);\n13: static void Cli_EnqueueByte(CliContext *cli, uint8_t byte);\n14: static uint8_t Cli_DequeueByte(CliContext *cli, uint8_t *byte);\n15: static void Cli_ProcessByte(CliContext *cli, uint8_t byte);\n16: static void Cli_ExecuteLine(CliContext *cli);\n17: static int Cli_Tokenize(char *line, char **argv, size_t max_args);\n18: static void Cli_WriteByteIsr(UART_HandleTypeDef *huart, uint8_t byte);\n19: static void Cli_WriteStringIsr(UART_HandleTypeDef *huart, const char *text);\n20: \n21: volatile DebugCliStatsData DebugCliStats;\n22: \n23: void Cli_Init(CliContext *cli, UART_HandleTypeDef *uart, const CliCommand *commands, size_t command_count)\n24: {\n25:   memset(cli, 0, sizeof(*cli));\n26:   cli->uart = uart;\n27:   cli->commands = commands;\n28:   cli->command_count = command_count;\n29:   memset((void *)&DebugCliStats, 0, sizeof(DebugCliStats));\n30: }\n31: \n32: HAL_StatusTypeDef Cli_Start(CliContext *cli)\n33: {\n34:   Cli_WriteString(cli, \"\\r\\nSTM32 UART CLI ready.\\r\\n\");\n35:   Cli_WriteString(cli, \"Console: USART2 @ 115200 8N1, TX=PA2, RX=PA3\\r\\n\");\n36:   Cli_WriteString(cli, \"Type 'help' to list commands.\\r\\n\\r\\n\");\n37:   Cli_ShowPrompt(cli);\n38: \n39:   return Cli_ArmReceive(cli);\n40: }\n41: \n42: void Cli_Process(CliContext *cli)\n43: {\n44:   uint8_t byte = 0U;\n45: \n46:   if (cli->uart_error != 0U)\n47:   {\n48:     cli->uart_error = 0U;\n49:     Cli_ResetInputState(cli);\n50:     Cli_WriteString(cli, \"\\r\\n[warn] UART receive error, input state reset.\\r\\n\");\n51:     Cli_ShowPrompt(cli);\n52:   }\n53: \n54:   if (cli->rx_overflow != 0U)\n55:   {\n56:     cli->rx_overflow = 0U;\n57:     Cli_ResetInputState(cli);\n58:     Cli_WriteString(cli, \"\\r\\n[error] RX queue overflow, current input discarded.\\r\\n\");\n59:     Cli_ShowPrompt(cli);\n60:   }\n61: \n62:   while (Cli_DequeueByte(cli, &byte) != 0U)\n63:   {\n64:     Cli_ProcessByte(cli, byte);\n65:   }\n66: }\n67: \n68: void Cli_HandleRxComplete(CliContext *cli, UART_HandleTypeDef *huart)\n69: {\n70:   if (huart != cli->uart)\n71:   {\n72:     return;\n73:   }\n74: \n75:   DebugCliStats.rx_bytes++;\n76: \n77:   if ((cli->rx_byte == '\\r') || (cli->rx_byte == '\\n'))\n78:   {\n79:     if ((cli->rx_byte == '\\n') && (cli->rx_cr_seen != 0U))\n80:     {\n81:       cli->rx_cr_seen = 0U;\n82:     }\n83:     else\n84:     {\n85:       Cli_WriteStringIsr(huart, \"\\r\\n\");\n86:       cli->rx_cr_seen = (cli->rx_byte == '\\r') ? 1U : 0U;\n87:     }\n88:   }\n89:   else if ((cli->rx_byte == '\\b') || (cli->rx_byte == 0x7FU))\n90:   {\n91:     cli->rx_cr_seen = 0U;\n92:     Cli_WriteStringIsr(huart, \"\\b \\b\");\n93:   }\n94:   else if (isprint(cli->rx_byte) != 0)\n95:   {\n96:     cli->rx_cr_seen = 0U;\n97:     Cli_WriteByteIsr(huart, cli->rx_byte);\n98:   }\n99:   else\n100:   {\n101:     cli->rx_cr_seen = 0U;\n102:   }\n103: \n104:   Cli_EnqueueByte(cli, cli->rx_byte);\n105:   (void)Cli_ArmReceive(cli);\n106: }\n107: \n108: void Cli_HandleError(CliContext *cli, UART_HandleTypeDef *huart)\n109: {\n110:   if (huart != cli->uart)\n111:   {\n112:     return;\n113:   }\n114: \n115:   DebugCliStats.uart_error++;\n116:   cli->uart_error = 1U;\n117:   __HAL_UART_CLEAR_OREFLAG(huart);\n118:   __HAL_UART_CLEAR_NEFLAG(huart);\n119:   __HAL_UART_CLEAR_FEFLAG(huart);\n120:   __HAL_UART_CLEAR_PEFLAG(huart);\n121:   (void)Cli_ArmReceive(cli);\n122: }\n123: \n124: void Cli_Write(CliContext *cli, const uint8_t *data, uint16_t length)\n125: {\n126:   if ((cli == NULL) || (cli->uart == NULL) || (data == NULL) || (length == 0U))\n127:   {\n128:     return;\n129:   }\n130: \n131:   (void)HAL_UART_Transmit(cli->uart, (uint8_t *)data, length, HAL_MAX_DELAY);\n132: }\n133: \n134: void Cli_WriteString(CliContext *cli, const char *text)\n135: {\n136:   if (text == NULL)\n137:   {\n138:     return;\n139:   }\n140: \n141:   Cli_Write(cli, (const uint8_t *)text, (uint16_t)strlen(text));\n142: }\n143: \n144: void Cli_Printf(CliContext *cli, const char *format, ...)\n145: {\n146:   char buffer[160];\n147:   va_list args;\n148:   int length = 0;\n149: \n150:   va_start(args, format);\n151:   length = vsnprintf(buffer, sizeof(buffer), format, args);\n152:   va_end(args);\n153: \n154:   if (length <= 0)\n155:   {\n156:     return;\n157:   }\n158: \n159:   if ((size_t)length >= sizeof(buffer))\n160:   {\n161:     length = (int)(sizeof(buffer) - 1U);\n162:   }\n163: \n164:   Cli_Write(cli, (const uint8_t *)buffer, (uint16_t)length);\n165: }\n166: \n167: void Cli_ShowPrompt(CliContext *cli)\n168: {\n169:   Cli_WriteString(cli, CLI_PROMPT);\n170: }\n171: \n172: void Cli_RecordCommandError(const char *command_text)\n173: {\n174:   DebugCliStats.cmd_err++;\n175:   if ((command_text != NULL) && (command_text[0] != '\\0'))\n176:   {\n177:     CliStats_CopyLastCommand(command_text);\n178:   }\n179: }\n180: \n181: const CliCommand *Cli_FindCommand(const CliContext *cli, const char *name)\n182: {\n183:   size_t index = 0U;\n184: \n185:   if ((cli == NULL) || (name == NULL))\n186:   {\n187:     return NULL;\n188:   }\n189: \n190:   for (index = 0U; index < cli->command_count; ++index)\n191:   {\n192:     if (strcmp(cli->commands[index].name, name) == 0)\n193:     {\n194:       return &cli->commands[index];\n195:     }\n196:   }\n197: \n198:   return NULL;\n199: }\n200: \n201: size_t Cli_GetCommandCount(const CliContext *cli)\n202: {\n203:   return (cli == NULL) ? 0U : cli->command_count;\n204: }\n205: \n206: const CliCommand *Cli_GetCommandAt(const CliContext *cli, size_t index)\n207: {\n208:   if ((cli == NULL) || (index >= cli->command_count))\n209:   {\n210:     return NULL;\n211:   }\n212: \n213:   return &cli->commands[index];\n214: }\n215: \n216: static HAL_StatusTypeDef Cli_ArmReceive(CliContext *cli)\n217: {\n218:   return HAL_UART_Receive_IT(cli->uart, &cli->rx_byte, 1U);\n219: }\n220: \n221: static void Cli_ResetInputState(CliContext *cli)\n222: {\n223:   cli->rx_head = 0U;\n224:   cli->rx_tail = 0U;\n225:   cli->line_length = 0U;\n226:   cli->last_eol_was_cr = 0U;\n227:   cli->rx_cr_seen = 0U;\n228:   cli->line_overflow = 0U;\n229: }\n230: \n231: static void CliStats_CopyLastCommand(const char *line)\n232: {\n233:   size_t index = 0U;\n234: \n235:   if (line == NULL)\n236:   {\n237:     DebugCliStats.last_cmd[0] = '\\0';\n238:     return;\n239:   }\n240: \n241:   while ((line[index] != '\\0') && (index < (sizeof(DebugCliStats.last_cmd) - 1U)))\n242:   {\n243:     DebugCliStats.last_cmd[index] = line[index];\n244:     index++;\n245:   }\n246: \n247:   DebugCliStats.last_cmd[index] = '\\0';\n248: }\n249: \n250: static void Cli_EnqueueByte(CliContext *cli, uint8_t byte)\n251: {\n252:   uint16_t next_head = (uint16_t)((cli->rx_head + 1U) % CLI_RX_QUEUE_SIZE);\n253: \n254:   if (next_head == cli->rx_tail)\n255:   {\n256:     DebugCliStats.rx_overflow++;\n257:     cli->rx_overflow = 1U;\n258:     return;\n259:   }\n260: \n261:   cli->rx_queue[cli->rx_head] = byte;\n262:   cli->rx_head = next_head;\n263: }\n264: \n265: static uint8_t Cli_DequeueByte(CliContext *cli, uint8_t *byte)\n266: {\n267:   if (cli->rx_tail == cli->rx_head)\n268:   {\n269:     return 0U;\n270:   }\n271: \n272:   *byte = cli->rx_queue[cli->rx_tail];\n273:   cli->rx_tail = (uint16_t)((cli->rx_tail + 1U) % CLI_RX_QUEUE_SIZE);\n274:   return 1U;\n275: }\n276: \n277: static void Cli_ProcessByte(CliContext *cli, uint8_t byte)\n278: {\n279:   if ((byte == '\\r') || (byte == '\\n'))\n280:   {\n281:     if ((byte == '\\n') && (cli->last_eol_was_cr != 0U))\n282:     {\n283:       cli->last_eol_was_cr = 0U;\n284:       return;\n285:     }\n286: \n287:     cli->last_eol_was_cr = (byte == '\\r') ? 1U : 0U;\n288:     DebugCliStats.rx_lines++;\n289: \n290:     if (cli->line_overflow != 0U)\n291:     {\n292:       cli->line_buffer[CLI_LINE_BUFFER_SIZE - 1U] = '\\0';\n293:       DebugCliStats.cmd_err++;\n294:       CliStats_CopyLastCommand(cli->line_buffer);\n295:       Cli_WriteString(cli, \"[error] command too long, max 63 chars.\\r\\n\");\n296:     }\n297:     else\n298:     {\n299:       cli->line_buffer[cli->line_length] = '\\0';\n300:       Cli_ExecuteLine(cli);\n301:     }\n302: \n303:     cli->line_length = 0U;\n304:     cli->line_overflow = 0U;\n305:     Cli_ShowPrompt(cli);\n306:     return;\n307:   }\n308: \n309:   cli->last_eol_was_cr = 0U;\n310: \n311:   if ((byte == '\\b') || (byte == 0x7FU))\n312:   {\n313:     if (cli->line_length > 0U)\n314:     {\n315:       cli->line_length--;\n316:     }\n317:     return;\n318:   }\n319: \n320:   if (isprint(byte) == 0)\n321:   {\n322:     return;\n323:   }\n324: \n325:   if (cli->line_length >= (CLI_LINE_BUFFER_SIZE - 1U))\n326:   {\n327:     cli->line_overflow = 1U;\n328:     return;\n329:   }\n330: \n331:   cli->line_buffer[cli->line_length++] = (char)byte;\n332: }\n333: \n334: static void Cli_ExecuteLine(CliContext *cli)\n335: {\n336:   char *argv[CLI_MAX_ARGS];\n337:   int argc = 0;\n338:   const CliCommand *command = NULL;\n339: \n340:   CliStats_CopyLastCommand(cli->line_buffer);\n341:   argc = Cli_Tokenize(cli->line_buffer, argv, CLI_MAX_ARGS);\n342:   if (argc == 0)\n343:   {\n344:     return;\n345:   }\n346: \n347:   if (argc < 0)\n348:   {\n349:     DebugCliStats.cmd_err++;\n350:     Cli_WriteString(cli, \"[error] too many arguments.\\r\\n\");\n351:     return;\n352:   }\n353: \n354:   command = Cli_FindCommand(cli, argv[0]);\n355:   if (command == NULL)\n356:   {\n357:     DebugCliStats.cmd_err++;\n358:     Cli_Printf(cli, \"[error] unknown command: %s\\r\\n\", argv[0]);\n359:     Cli_WriteString(cli, \"Type 'help' to list commands.\\r\\n\");\n360:     return;\n361:   }\n362: \n363:   DebugCliStats.cmd_ok++;\n364:   command->handler(cli, argc, argv);\n365: }\n366: \n367: static int Cli_Tokenize(char *line, char **argv, size_t max_args)\n368: {\n369:   int argc = 0;\n370:   char *cursor = line;\n371: \n372:   while (*cursor != '\\0')\n373:   {\n374:     while (isspace((unsigned char)*cursor) != 0)\n375:     {\n376:       cursor++;\n377:     }\n378: \n379:     if (*cursor == '\\0')\n380:     {\n381:       break;\n382:     }\n383: \n384:     if ((size_t)argc >= max_args)\n385:     {\n386:       return -1;\n387:     }\n388: \n389:     argv[argc++] = cursor;\n390: \n391:     while ((*cursor != '\\0') && (isspace((unsigned char)*cursor) == 0))\n392:     {\n393:       cursor++;\n394:     }\n395: \n396:     if (*cursor == '\\0')\n397:     {\n398:       break;\n399:     }\n400: \n401:     *cursor++ = '\\0';\n402:   }\n403: \n404:   return argc;\n405: }\n406: \n407: static void Cli_WriteByteIsr(UART_HandleTypeDef *huart, uint8_t byte)\n408: {\n409:   uint32_t timeout = 0xFFFFU;\n410: \n411:   while (((huart->Instance->SR & USART_SR_TXE) == 0U) && (timeout > 0U))\n412:   {\n413:     timeout--;\n414:   }\n415: \n416:   if (timeout == 0U)\n417:   {\n418:     return;\n419:   }\n420: \n421:   huart->Instance->DR = byte;\n422: }\n423: \n424: static void Cli_WriteStringIsr(UART_HandleTypeDef *huart, const char *text)\n425: {\n426:   while ((*text) != '\\0')\n427:   {\n428:     Cli_WriteByteIsr(huart, (uint8_t)(*text));\n429:     text++;\n430:   }\n431: }\n\n(End of file - total 431 lines)\n</content>","metadata":{"preview":"#include \"cli.h\"\n\n#include <ctype.h>\n#include <stdarg.h>\n#include <stdio.h>\n#include <string.h