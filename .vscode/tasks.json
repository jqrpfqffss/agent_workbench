{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Agent Workbench: Setup",
      "type": "shell",
      "command": "setup_workbench.bat",
      "problemMatcher": []
    },
    {
      "label": "Agent Workbench: Doctor",
      "type": "shell",
      "command": "agent_workbench.bat doctor",
      "problemMatcher": []
    },
    {
      "label": "Agent Workbench: Build",
      "type": "shell",
      "command": "agent_workbench.bat build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Agent Workbench: Debug Session",
      "type": "shell",
      "command": "agent_workbench.bat session debug",
      "problemMatcher": []
    },
    {
      "label": "Agent Workbench: Compare Latest",
      "type": "shell",
      "command": "agent_workbench.bat compare --latest",
      "problemMatcher": []
    },
    {
      "label": "Agent Workbench: Test Generate (Example)",
      "type": "shell",
      "command": "agent_workbench.bat test generate --task agent_workbench/tasks/example_feature.yaml",
      "problemMatcher": []
    },
    {
      "label": "Agent Workbench: Test Generate (CLI Regression)",
      "type": "shell",
      "command": "agent_workbench.bat test generate --task agent_workbench/tasks/cli_automation_regression.yaml",
      "problemMatcher": []
    },
    {
      "label": "Agent Workbench: Test Run",
      "type": "shell",
      "command": "agent_workbench.bat test run",
      "problemMatcher": []
    },
    {
      "label": "Agent Workbench: UART Console",
      "type": "shell",
      "command": "agent_workbench.bat uart console",
      "problemMatcher": []
    },
    {
      "label": "Agent Workbench: UART CLI Smoke",
      "type": "shell",
      "command": "agent_workbench.bat uart exec --reset-first --expect-ready --command help --command status --command red on --command green on --command blue on --command all off",
      "problemMatcher": []
    },
    {
      "label": "Agent Workbench: Monitor Start",
      "type": "shell",
      "command": "agent_workbench.bat monitor start",
      "problemMatcher": []
    },
    {
      "label": "Agent Workbench: Monitor Stop",
      "type": "shell",
      "command": "agent_workbench.bat monitor stop",
      "problemMatcher": []
    },
    {
      "label": "Agent Workbench: OpenOCD Start",
      "type": "shell",
      "command": "agent_workbench.bat openocd start",
      "problemMatcher": []
    },
    {
      "label": "Agent Workbench: OpenOCD Stop",
      "type": "shell",
      "command": "agent_workbench.bat openocd stop",
      "problemMatcher": []
    },
    {
      "label": "Agent Workbench: Flash (ST-Link)",
      "type": "shell",
      "command": "agent_workbench.bat flash --method stlink_cli",
      "problemMatcher": []
    },
    {
      "label": "Agent Workbench: Flash (OpenOCD)",
      "type": "shell",
      "command": "agent_workbench.bat flash --method openocd_cmd",
      "problemMatcher": []
    },
    {
      "label": "Agent Workbench: Feature Session (Example)",
      "type": "shell",
      "command": "agent_workbench.bat session feature --task agent_workbench/tasks/example_feature.yaml",
      "problemMatcher": []
    },
    {
      "label": "Agent Workbench: Feature Session (CLI Regression)",
      "type": "shell",
      "command": "agent_workbench.bat session feature --task agent_workbench/tasks/cli_automation_regression.yaml",
      "problemMatcher": []
    }
  ]
}